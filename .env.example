# Public site (Caddy). Use your domain for auto HTTPS; localhost for smoke tests.
DOMAIN=your.domain.com

# Clerk
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Local Postgres needs no SSL. For Neon/cloud, append ?sslmode=verify-full
# (not sslmode=require — that alias is deprecated in node-postgres).
DATABASE_URL=postgresql://kb:kb@localhost:5432/knowledge_workbench

# Local Docker Qdrant: http://127.0.0.1:6333
# Qdrant Cloud (VPS prod): https://xxxx.aws.cloud.qdrant.io — do NOT add :6333
# (JS client defaults missing HTTPS ports to 6333; we force 443).
QDRANT_URL=https://xxxx.aws.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_chunks

# Source file storage — local disk (default) or S3/R2
UPLOAD_DIR=
# Set S3_BUCKET to use object storage (AWS S3 or Cloudflare R2)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Required on VPS/production: residential HTTP(S) proxy for YouTube captions.
# Datacenter proxies usually fail. Only keep a proxy after this prints VPS_OK
# inside the app container:
#   bun run verify:youtube-proxy
# YOUTUBE_PROXY_URL=http://user:pass@host:port
YOUTUBE_PROXY_URL=
