# Public site (Caddy). Use your domain for auto HTTPS; localhost for smoke tests.
DOMAIN=your.domain.com

# Clerk
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Local Postgres needs no SSL. For Neon/cloud, append ?sslmode=verify-full
# (not sslmode=require — that alias is deprecated in node-postgres).
DATABASE_URL=postgresql://kb:kb@localhost:5432/knowledge_workbench

QDRANT_URL=https://xxxx.aws.cloud.qdrant.io
# Optional: only set a port if your cluster requires it.
# Do NOT add :6333 to Qdrant Cloud HTTPS URLs — the JS client already
# mishandles missing ports by defaulting to 6333 (we force 443 for https).
# Prefer a Cloud region near your app/users — upsert time is dominated by
# uploading ~1.5KB JSON per 1536-d vector over the network.
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_chunks

# Source file storage — local disk (default) or S3/R2
UPLOAD_DIR=
# Set S3_BUCKET to use object storage (AWS S3 or Cloudflare R2)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
